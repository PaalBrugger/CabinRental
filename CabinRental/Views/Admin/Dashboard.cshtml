@{
    ViewBag.Title = "Admin Panel";
    Layout = "_Layout";
}

<h2 class="text-white text-center mt-4">Admin Panel</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-body text-center">
                    <h5 class="card-title">Manage Users</h5>
                    <p class="card-text">View, edit, and manage user accounts.</p>
                    <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-primary w-100">Go to Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-body text-center">
                    <h5 class="card-title">Manage Reservations</h5>
                    <p class="card-text">View and control all reservations.</p>
                    <a asp-controller="Admin" asp-action="ManageReservations" class="btn btn-primary w-100">Go to
                        Reservations</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-body text-center">
                    <h5 class="card-title">Manage Cabins</h5>
                    <p class="card-text">View, edit and manage cabins.</p>
                    <a asp-controller="Admin" asp-action="ManageCabins" class="btn btn-primary w-100">Go to
                        Reservations</a>
                </div>
            </div>
        </div>
    </div>
</div>
