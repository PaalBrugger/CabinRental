@model IEnumerable<Cabin>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1 class="text-center text-white mb-4 pb-2">Available Cabins</h1>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var cabin in Model)
        {
            <div id="Carousel-@cabin.Id" class="carousel slide" data-bs-ride="false" data-bs-interval="false"> <!-- Auto carousel off -->
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img class="d-block w-100" src="@cabin.Images.First().ImagePath" alt="First slide">
                    </div>
                    <div class="carousel-item ">
                        <img class="d-block w-100" src="@cabin.Images.ToList()[1].ImagePath" alt="Second slide">
                    </div>
                   
                </div>
                <a class="carousel-control-prev" href="#Carousel-@cabin.Id" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#Carousel-@cabin.Id" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
            
            

            <div class="card-body">
                <h5 class="card-title text-white">@cabin.Name</h5>
                <p class="card-text text-white">@cabin.Address</p>
                <p class="card-text text-white">@cabin.City</p>
                <p class="fw-bold text-white">$@cabin.Price/night</p>
                <a type="button" asp-area="Customer" asp-controller="Cabin" asp-action="Cabin" asp-route-cabinId="@cabin.Id" class="btn btn-primary">Book Now</a>
            </div>
        }
    </div>
    
    
</div>


<style>
    .carousel-item img {
        height: 300px; /* Set a consistent height */
        object-fit: cover; /* Ensures images scale proportionally and fill the container */
        width: 100%; /* Ensure images span the full width of the carousel */
    }
</style>

