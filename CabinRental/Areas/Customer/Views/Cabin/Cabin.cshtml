@model Cabin


@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1 class="text-center text-white pb-5">@Model.Name</h1>

    <div class="row">
        <div class="col-md-6">
            <!-- Carousel for Multiple Images -->
            <div id="Carousel-@Model.Id" class="carousel slide" data-bs-ride="false" data-bs-interval="false"> <!-- Auto carousel off -->
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img class="d-block w-100" src="@Model.Images.First().ImagePath" alt="First slide">
                    </div>
                    <div class="carousel-item ">
                        <img class="d-block w-100" src="@Model.Images.ToList()[1].ImagePath" alt="Second slide">
                    </div>

                </div>
                <a class="carousel-control-prev" href="#Carousel-@Model.Id" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#Carousel-@Model.Id" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <h2 class="text-white">$@Model.Price/night</h2>
            <p class="text-white"><strong>Description:</strong> @Model.Description</p>
            <p class="text-white"><strong>Location:</strong> @Model.Address, @Model.City</p>
            
            <a asp-area="Customer" asp-controller="Reservation" asp-action="CreateReservationForm" asp-route-cabinId="@Model.Id" class="btn btn-success">Book Now</a>
            <a asp-area="Customer" asp-controller="Cabin" asp-action="CabinList" class="btn btn-secondary">⬅  Back to List</a>
        </div>
    </div>
    
    <h1 class="text-white pt-3 pb-3" > Availability</h1>
    <div class="pb-5" id="calendar"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var calendarEl = document.getElementById("calendar");

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: "dayGridMonth",
                events: "/Customer/Cabin/GetReservations?cabinId=@Model.Id", // Fetch booked dates
                eventColor: "red", // Default color for booked dates
                height: 500,
                contentHeight: "auto",

                schedulerLicenseKey: 'GPL-My-Project-Is-Open-Source'

            });

            calendar.render();
        });
    </script>
    <style>
        .fc-toolbar-title {
            color: white !important;
        }

        .fc-button {
            color: white !important;
        }

        .fc-button-primary {
            background-color: transparent !important;
            border-color: white !important;
        }

        .fc-prev-button, .fc-next-button {
            color: white !important;
        }
        .fc-daygrid-day:hover {
            background-color: transparent !important;
        }
    </style>
</div>