@model IEnumerable<Cabin>

@{
    ViewBag.Title = "Manage Cabins";
    Layout = "_Layout";
}

<h2 class="text-white">Cabins</h2>

<table class="table table-dark table-striped mt-4">
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>City</th>
        <th>Address</th>
        <th>Price Per Night</th>
        <th>Description</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var cabin in Model)
    {
        <tr>
            <td>@cabin.Id</td>
            <td>@cabin.Name</td>
            <td>@cabin.City</td>
            <td>@cabin.Address</td>
            <td>$@cabin.Price</td>
            <td>@cabin.Description</td>
            <td>
                <a asp-action="EditCabinForm" asp-route-id="@cabin.Id" class="btn btn-warning btn-sm">Edit</a>

                <form asp-action="DeleteCabin" asp-route-id="@cabin.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this cabin?');">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-area="Admin" asp-controller="CabinManager" asp-action="CreateCabinForm" class="btn btn-success mt-3">Add New Cabin</a>
<a asp-area="Admin" asp-controller="Dashboard" asp-action="Dashboard" class="btn btn-secondary mt-3">Back to Admin Panel</a>

<input type="hidden" id="tempDataSuccessMessage" value="@TempData["SuccessMessage"]" />

@section Scripts {
    <script src="~/js/toastrNotification.js"></script>
}