@model AdminReservationViewModel

@{
    ViewBag.Title = "Add Reservation";
    Layout = "_Layout";
}

<h2 class="text-white">Add New Reservation</h2>

<form asp-area="Admin" asp-controller="ReservationManager" asp-action="CreateReservation" method="post">

    <div class="text-white">

        <div class="mb-3">
            <label>Select User</label>
            <select asp-for="UserId" asp-items="Model.Users" class="form-control">
                <option value="">-- Select User --</option>
            </select>
            <span class="text-danger" asp-validation-for="UserId"></span>
        </div>

        <div class="mb-3">
            <label>Select Cabin</label>
            <select asp-for="CabinId" asp-items="Model.Cabins" id="cabinSelect" class="form-control">
                <option value="">-- Select Cabin --</option>
            </select>
            <span class="text-danger" asp-validation-for="CabinId"></span>
        </div>
        <div class="mb-3">
            <label>First Name</label>
            <input asp-for="FirstName" class="form-control"/>
            <span class="text-danger" asp-validation-for="FirstName"></span>
        </div>

        <div class="mb-3">
            <label>Last Name</label>
            <input asp-for="LastName" class="form-control"/>
            <span class="text-danger" asp-validation-for="LastName"></span>
        </div>

        <div class="mb-3">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control"/>
            <span class="text-danger" asp-validation-for="PhoneNumber"></span>
        </div>

        <div class="mb-3">
            <label>Address</label>
            <input asp-for="Address" class="form-control"/>
            <span class="text-danger" asp-validation-for="Address"></span>
        </div>

        <!-- FullCalendar Booking Selection -->
        <div id="calendar"></div>

        <div class="row pb-3">
            <div class="col-md-6">
                <label class="pb-3 pt-3" for="checkInDate"><strong>New Check-in Date</strong></label>
                <input asp-for="CheckInDate" id="checkInDate" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label class="pb-3 pt-3" for="checkOutDate"><strong>New Check-out Date</strong></label>
                <input asp-for="CheckOutDate" id="checkOutDate" class="form-control"/>
            </div>
        </div>
        <input type="hidden" asp-for="PricePerNight" id="pricePerNight"/>

        <div class="mb-3">
            <label>Total Price</label>
            <input asp-for="TotalPrice" id="totalPrice" class="form-control" readonly/>
        </div>

        <button type="submit" class="btn btn-primary w-100">Add Reservation</button>
        <a asp-area="Admin" asp-controller="ReservationManager" asp-action="ManageReservations"
           class="btn btn-secondary w-100 mt-2">
            Cancel
        </a>
    </div>
</form>

<input type="hidden" id="tempDataFailureMessage" value="@TempData["Error"]"/>
<input type="hidden" id="tempDataSuccessMessage" value="@TempData["SuccessMessage"]"/>

@section Scripts {
    <script src="~/js/toastrNotification.js"></script>
    <script src="~/js/createReservationAdmin.js"></script>
}
