@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewBag.Title = "Manage Users";
    Layout = "_Layout";
}

<h2 class="text-white">Manage Users</h2>

<table class="table table-dark table-striped mt-4">
    <thead>
    <tr>
        <th>Email</th>
        <th>Username</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.UserName</td>
            <td>
                <a asp-area="Admin" asp-controller="UserManager" asp-action="EditUserForm" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Edit</a>

                <form asp-controller="UserManager" asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this user?');">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-area="Admin" asp-controller="UserManager" asp-action="CreateUserForm" class="btn btn-success mt-3">Add New User</a>
<a asp-controller="Dashboard" asp-action="Dashboard" class="btn btn-secondary mt-3">Back to Admin Panel</a>

<input type="hidden" id="tempDataSuccessMessage" value="@TempData["SuccessMessage"]" />

@section Scripts {
<script src="~/js/toastrNotification.js"></script>
}